# Ambiente local. Em produção use APP_ENV=production.
APP_ENV=development

# Gere uma chave forte antes de publicar a aplicação.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Em Hostinger VPS, aceite somente o domínio real e exatamente um proxy NGINX.
TRUSTED_HOSTS=nutra.seudominio.com.br
TRUSTED_PROXY_HOPS=0

# Caminho opcional do banco SQLite (somente desenvolvimento e testes).
DATABASE_PATH=instance/nexus_nutra.db

# Diretórios privados para anexos clínicos e fotos do diário.
CLINICAL_UPLOAD_FOLDER=instance/clinical_uploads
DIARY_UPLOAD_FOLDER=instance/diary_uploads

# Use 1 apenas no desenvolvimento local.
FLASK_DEBUG=0

# URL pública usada nos links de confirmação e recuperação.
PUBLIC_BASE_URL=https://nutra.seudominio.com.br

# Exija confirmação de e-mail para novos acessos.
REQUIRE_EMAIL_VERIFICATION=1

# E-mail transacional. Nunca salve credenciais reais no Git.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT=10
MAIL_FROM=Nexus Nutra <noreply@seudominio.com.br>

# Use 1 apenas em desenvolvimento/testes para capturar mensagens sem enviá-las.
MAIL_SUPPRESS_SEND=1
